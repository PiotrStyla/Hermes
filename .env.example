# LLM Provider - OpenRouter (default)
OPENROUTER_API_KEY=your-openrouter-key-here

# Default model used by all agents unless individually overridden
DEFAULT_MODEL=deepseek/deepseek-v4-flash

# Optional per-agent model overrides
# Uncomment these to use Claude Sonnet (enables prompt cache, costs ~$3/1M tokens via OpenRouter).
# Cache token savings show up in DEBUG logs as [cache] created=N read=N.
# OPERATOR_MODEL=anthropic/claude-sonnet-4
# SUPERVISOR_MODEL=anthropic/claude-sonnet-4
# MANAGER_MODEL=anthropic/claude-sonnet-4
# REPORT_MODEL=deepseek/deepseek-v4-flash      # reports don't benefit from cache — keep cheap
# SENIOR_PERSONA_MODEL=deepseek/deepseek-v4-flash

# ----- Voice mode (only required when using `--voice`) -----

# ElevenLabs (Text-to-Speech for the Operator)
ELEVENLABS_API_KEY=
# Default is a warm female voice. Browse voices at https://elevenlabs.io/app/voice-library
# Some good multilingual options:
#   Rachel  21m00Tcm4TlvDq8ikWAM   warm female
#   Bella   EXAVITQu4vr4xnSDxMaL   soft female
#   Charlie IKne3meq5aSn9XLyUdCD   friendly male
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2

# OpenAI (Whisper for Speech-to-Text). Get a key at https://platform.openai.com
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1

# ----- Telephony / Twilio (only required for `twilio-*` commands) -----

# Twilio Account credentials. Find at https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your purchased Twilio number, E.164 format. E.g. +48..., +1...
TWILIO_FROM_NUMBER=

# Public HTTPS base URL where Twilio can reach our webhook server.
# In dev: run `ngrok http 8000` and paste the https forwarding URL here (no trailing slash).
# In prod: your deployed server's base URL.
TELEPHONY_PUBLIC_URL=

# Twilio answering-machine detection. Options:
#   DetectMessageEnd  — wait for the voicemail beep before deciding (recommended)
#   Enable            — fastest, may misclassify
#   (empty)           — disabled
TWILIO_MACHINE_DETECTION=DetectMessageEnd

# Per-turn <Record> tuning
TWILIO_RECORD_MAX_SECONDS=20
TWILIO_RECORD_SILENCE_SECONDS=3

# ----- Email notifications (family report delivered after each call) -----
# Leave blank to disable email (calls still work fine without it).
#
# Gmail App Password setup:
#   1. myaccount.google.com → Security → 2-Step Verification → App passwords
#   2. Generate a 16-char password for "Mail / Windows Computer"
#   3. Use that password as SMTP_PASSWORD (no spaces)
#
# SendGrid SMTP relay:
#   SMTP_HOST=smtp.sendgrid.net  SMTP_USER=apikey  SMTP_PASSWORD=<API key>
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
SMTP_FROM=your-gmail@gmail.com

# ---- Twilio Media Streams (real-time voice, Phase 6) ----
# Enable bidirectional WebSocket audio instead of <Play> + <Record> loop.
# Set to "0" to use the legacy play/record flow.
TWILIO_STREAM_ENABLED=1

# Streaming STT provider (required for Media Streams).
# Deepgram is recommended for real-time transcription (~200ms latency).
# Falls back to batch Whisper at end-of-turn when DEEPGRAM_API_KEY is missing.
DEEPGRAM_API_KEY=
