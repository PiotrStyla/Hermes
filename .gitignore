# Environment
.env
.venv/
venv/
__pycache__/
*.pyc

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Per-senior generated artifacts (transcripts and reports are not committed)
data/seniors/*/transcripts/
data/seniors/*/reports/

# Per-senior compliance state (consent / retention) — contains PII, do not commit
data/seniors/*/consent.json
data/seniors/*/retention.json

# Append-only audit log — contains PII, do not commit
data/audit/

# Human review queue entries — reference per-senior data, do not commit
data/review_queue/

# Per-call telephony state (history, audio, recordings) — contains PII, do not commit
data/calls/

# Versioned skill snapshots (regenerated as system runs)
data/skills/operator/_versions/
